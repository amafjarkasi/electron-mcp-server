{
  "name": "electron-debug-mcp",
  "version": "1.5.1",
  "description": "MCP server for launching and debugging Electron apps via Chrome DevTools Protocol",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "electron-debug-mcp": "./build/index.js"
  },
  "files": [
    "build/",
    "assets/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "fix-electron": "node scripts/ensure-electron.mjs",
    "postinstall": "node scripts/ensure-electron.mjs",
    "prepublishOnly": "npm run build",
    "build": "tsc && node --input-type=module -e \"import fs from 'fs'; fs.chmodSync('build/index.js', 0o755)\"",
    "start": "node build/index.js",
    "dev": "tsc && node build/index.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run ensure-electron",
    "test": "npm run build && npm run test:unit && npm run test:smoke",
    "test:unit": "node --test test/unit-helpers.test.mjs test/probe.test.mjs test/monitor.test.mjs",
    "test:smoke": "node test/mcp-smoke.mjs",
    "doctor": "npm run build && node scripts/doctor.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "electron",
    "debug",
    "mcp",
    "model-context-protocol",
    "chrome-devtools-protocol",
    "devtools",
    "cursor"
  ],
  "author": "amafjarkasi",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amafjarkasi/electron-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/amafjarkasi/electron-mcp-server/issues"
  },
  "homepage": "https://github.com/amafjarkasi/electron-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.1.0",
    "chrome-remote-interface": "^0.33.0",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "electron": "^29.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=18"
  }
}
