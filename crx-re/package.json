{
  "name": "crx-re",
  "private": true,
  "type": "module",
  "description": "CLI AI agent that unpacks Chrome extensions into a readable inventory",
  "bin": {
    "crx-re": "cli/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
